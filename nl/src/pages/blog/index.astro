---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const nlDate = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Peptidux Blog',
  description: 'Wetenschappelijke achtergrondartikelen over researchpeptiden: werkingsmechanismen, onderzoeksmethoden en laboratoriumpraktijk.',
  url: new URL('/blog/', Astro.site).href,
  inLanguage: 'nl',
  publisher: { '@type': 'Organization', name: 'Peptidux' },
};
---

<Layout
  title="Blog — Peptidux"
  description="Wetenschappelijke achtergrondartikelen over researchpeptiden: werkingsmechanismen, onderzoeksmethoden, opslag, zuiverheid en de actuele stand van het onderzoek."
>
  <section class="blog-hero">
    <p class="blog-hero__eyebrow"><span aria-hidden="true"></span>Peptidux onderzoeksjournaal</p>
    <h1>Blog</h1>
    <p>
      Onafhankelijke achtergrondartikelen over researchpeptiden: werkingsmechanismen,
      laboratoriumpraktijk en de huidige stand van de wetenschap. Alle artikelen zijn
      uitsluitend bedoeld als voorlichting voor onderzoeksdoeleinden.
    </p>
  </section>

  <section class="blog-list" aria-label="Alle blogartikelen">
    {
      posts.map((post) => (
        <article class="blog-card">
          <a href={`/blog/${post.id}/`} class="blog-card__link">
            <p class="blog-card__meta">
              <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                {nlDate.format(post.data.pubDate)}
              </time>
              <span aria-hidden="true">&middot;</span>
              <span>{post.data.author}</span>
            </p>
            <h2>{post.data.title}</h2>
            <p class="blog-card__excerpt">{post.data.description}</p>
            <span class="blog-card__cta">Lees het artikel &rarr;</span>
          </a>
        </article>
      ))
    }
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />
</Layout>

<style>
  .blog-hero {
    max-width: 48rem;
    padding-block: clamp(4rem, 9vw, 6.5rem) 0;
  }
  .blog-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-lab-cyan);
  }
  .blog-hero__eyebrow span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-lab-mint);
  }
  .blog-hero h1 {
    margin: 1rem 0 0;
    color: var(--color-lab-heading);
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .blog-hero p {
    margin: 1.5rem 0 0;
    max-width: 62ch;
    color: var(--color-lab-text);
    font-size: 1.1rem;
    line-height: 1.75;
  }
  .blog-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: 1.25rem;
    max-width: 72rem;
    margin-inline: auto;
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .blog-card {
    border: 1px solid var(--color-lab-rule);
    border-radius: var(--radius-control);
    background: var(--color-lab-panel);
    transition: border-color 180ms ease, transform 180ms ease;
  }
  .blog-card:hover {
    border-color: var(--color-lab-cyan);
    transform: translateY(-2px);
  }
  .blog-card__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    text-decoration: none;
    height: 100%;
  }
  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-lab-muted);
  }
  .blog-card h2 {
    margin: 0;
    color: var(--color-lab-heading);
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .blog-card__excerpt {
    margin: 0;
    color: var(--color-lab-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .blog-card__cta {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--color-lab-cyan);
  }
</style>
