---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((post, index, all) => ({
      params: { slug: post.id },
      props: {
        post,
        newer: index > 0 ? all[index - 1] : null,
        older: index < all.length - 1 ? all[index + 1] : null,
      },
    }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

const nlDate = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString().slice(0, 10),
  dateModified: post.data.pubDate.toISOString().slice(0, 10),
  keywords: post.data.tags.join(', '),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Peptidux' },
  inLanguage: 'nl',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout title={`${post.data.title} — Peptidux Blog`} description={post.data.description}>
  <article class="post">
    <header class="post__header">
      <p class="post__crumb"><a href="/blog/">Blog</a><span aria-hidden="true">/</span>{post.data.title}</p>
      <h1>{post.data.title}</h1>
      <p class="post__meta">
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{nlDate.format(post.data.pubDate)}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{post.data.author}</span>
      </p>
      {post.data.tags.length > 0 && (
        <ul class="post__tags" aria-label="Tags">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>
    <div class="md-content">
      <Content />
    </div>
    <footer class="post__nav">
      {newer ? (
        <a href={`/blog/${newer.id}/`} class="post__nav-link">
          <span>Nieuwer artikel</span>
          <strong>{newer.data.title}</strong>
        </a>
      ) : <span />}
      {older ? (
        <a href={`/blog/${older.id}/`} class="post__nav-link post__nav-link--right">
          <span>Ouder artikel</span>
          <strong>{older.data.title}</strong>
        </a>
      ) : <span />}
    </footer>
    <div class="post__disclaimer">
      <p>
        Dit artikel is uitsluitend bedoeld als wetenschappelijke voorlichting. Alle genoemde stoffen zijn
        researchpeptiden, bestemd voor laboratoriumonderzoek en niet voor menselijke of diergeneeskundige
        consumptie. Raadpleeg voor medische vragen altijd een arts.
      </p>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</Layout>

<style>
  .post {
    max-width: 48rem;
    margin-inline: auto;
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .post__crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-lab-faint);
  }
  .post__crumb a {
    color: var(--color-lab-cyan);
    text-decoration: none;
  }
  .post__crumb a:hover {
    text-decoration: underline;
  }
  .post__header h1 {
    margin: 1.25rem 0 0;
    color: var(--color-lab-heading);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.5vw, 2.9rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-lab-muted);
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .post__tags li {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--color-lab-rule);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--color-lab-muted);
    background: var(--color-lab-panel-raised);
  }
  .post .md-content {
    margin-top: 2.5rem;
  }
  .post__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-lab-rule);
  }
  .post__nav-link {
    flex: 1 1 14rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-lab-rule);
    border-radius: var(--radius-control);
    text-decoration: none;
    transition: border-color 180ms ease;
  }
  .post__nav-link:hover {
    border-color: var(--color-lab-cyan);
  }
  .post__nav-link span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-lab-faint);
  }
  .post__nav-link strong {
    color: var(--color-lab-heading);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .post__nav-link--right {
    text-align: right;
  }
  .post__disclaimer {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-lab-mint);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
    background: var(--color-lab-cyan-glow);
  }
  .post__disclaimer p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-lab-text);
  }
</style>
