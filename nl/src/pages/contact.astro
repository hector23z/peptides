---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Peptidux" description="Neem contact op met Peptidux voor vragen over bestellingen, producten of certificaten van analyse. Uitsluitend voor onderzoeksgebruik.">
  <section class="max-w-3xl">
    <h1 class="font-display text-4xl font-medium tracking-tight text-lab-heading">Neem contact op</h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-lab-muted">
      Vragen over een bestelling, een product of een certificaat van analyse? Ons team helpt u graag.
      Wij reageren doorgaans binnen één werkdag.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <div class="rounded-[12px] border border-lab-rule bg-lab-panel p-6">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-lab-muted">E-mail</h2>
        <p class="mt-2 font-mono text-lab-text">support@peptidux.example</p>
      </div>
      <div class="rounded-[12px] border border-lab-rule bg-lab-panel p-6">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-lab-muted">Openingstijden</h2>
        <p class="mt-2 font-mono text-lab-text">Ma&ndash;vr, 9:00&ndash;18:00 (CET)</p>
      </div>
    </div>
    <form class="mt-10 space-y-4" method="post" action="/contact/">
      <div>
        <label for="name" class="mb-1 block text-sm text-lab-muted">Naam</label>
        <input id="name" name="name" type="text" class="w-full rounded-md border border-lab-rule bg-lab-panel px-4 py-2 text-lab-text outline-none focus:border-lab-cyan" />
      </div>
      <div>
        <label for="email" class="mb-1 block text-sm text-lab-muted">E-mailadres</label>
        <input id="email" name="email" type="email" class="w-full rounded-md border border-lab-rule bg-lab-panel px-4 py-2 text-lab-text outline-none focus:border-lab-cyan" />
      </div>
      <div>
        <label for="message" class="mb-1 block text-sm text-lab-muted">Bericht</label>
        <textarea id="message" name="message" rows="5" class="w-full rounded-md border border-lab-rule bg-lab-panel px-4 py-2 text-lab-text outline-none focus:border-lab-cyan"></textarea>
      </div>
      <button type="submit" class="rounded-md bg-lab-cyan px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-lab-cyan-deep">
        Bericht versturen
      </button>
    </form>
  </section>
</Layout>
