---
interface Props {
  id?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { id, title, description, href, linkLabel } = Astro.props;
---

<header class="section-heading">
  <div>
    <h2 id={id}>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  {href && linkLabel && <a href={href} class="text-link">{linkLabel}</a>}
</header>
