---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const category = (await getCollection('categories')).find((c) => c.data.slug === slug);
const products = (await getCollection('products'))
  .filter((p) => p.data.category === slug)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={`${category?.data.title ?? slug} — PeptideLab`} description={category?.data.description}>
  <section class="max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-widest text-cyan-400">Category</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-zinc-50">{category?.data.title ?? slug}</h1>
    <p class="mt-6 text-base leading-relaxed text-zinc-400">{category?.data.description}</p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">Products in this category</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <a href={`/${slug}/${p.id}/`} class="group rounded-lg border border-zinc-800 bg-zinc-900/50 p-6 transition-colors hover:border-cyan-500/60">
            <h3 class="text-lg font-semibold text-zinc-100 group-hover:text-cyan-300">{p.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{p.data.description}</p>
            <div class="mt-4 flex items-center justify-between text-sm">
              <span class="font-mono text-xs text-zinc-500">{p.data.purity}</span>
              <span class="font-semibold text-cyan-300">{p.data.price ? `$${p.data.price}` : ''}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
