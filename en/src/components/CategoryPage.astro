---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const category = (await getCollection('categories')).find((c) => c.data.slug === slug);
const products = (await getCollection('products'))
  .filter((p) => p.data.category === slug)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={`${category?.data.title ?? slug} — PeptideLab`} description={category?.data.description}>
  <section class="max-w-3xl">
    <h1 class="font-display text-4xl font-medium tracking-tight text-lab-heading">{category?.data.title ?? slug}</h1>
    <p class="mt-6 text-base leading-relaxed text-lab-muted">{category?.data.description}</p>
  </section>

  <section class="mt-12">
    <h2 class="font-display text-2xl font-medium tracking-tight text-lab-heading">Products in this category</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <a href={`/${slug}/${p.id}/`} class="group rounded-[12px] border border-lab-rule bg-lab-panel p-6 transition-colors hover:border-lab-cyan/60 hover:bg-lab-panel-raised">
            <h3 class="font-display text-lg font-medium text-lab-heading group-hover:text-lab-cyan">{p.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-lab-muted">{p.data.description}</p>
            <div class="mt-4 flex items-center justify-between text-sm">
              <span class="font-mono text-xs text-lab-faint">{p.data.purity}</span>
              <span class="font-mono font-medium text-lab-cyan">{p.data.price ? `$${p.data.price}` : ''}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
