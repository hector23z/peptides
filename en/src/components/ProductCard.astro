---
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;

const categoryImages: Record<string, string> = {
  recovery: '/images/recovery.png',
  'glp-1': '/images/glp1.png',
  longevity: '/images/longevity.png',
  hgh: '/images/hgh.png',
};

const categoryLabels: Record<string, string> = {
  recovery: 'Recovery',
  'glp-1': 'GLP-1 research',
  longevity: 'Longevity',
  hgh: 'HGH research',
};
---

<article class="product-card">
  <a href={`/${product.data.category}/${product.id}/`} aria-label={`View ${product.data.title}`}>
    <div class="product-card__media">
      <img
        src={categoryImages[product.data.category] ?? '/images/hero-home.png'}
        alt=""
        width="1254"
        height="1254"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span>{categoryLabels[product.data.category] ?? product.data.category}</span>
    </div>
    <div class="product-card__body">
      <h3>{product.data.title}</h3>
      <p>{product.data.description}</p>
      <dl class="product-card__specs">
        <div>
          <dt>Purity</dt>
          <dd>{product.data.purity ?? 'See batch'}</dd>
        </div>
        <div>
          <dt>Format</dt>
          <dd>{product.data.size ?? 'See listing'}</dd>
        </div>
      </dl>
      <div class="product-card__footer">
        <span class="product-card__price">{product.data.price ? `$${product.data.price}` : 'Enquire'}</span>
        <span class="product-card__action">View compound <span aria-hidden="true">&rarr;</span></span>
      </div>
    </div>
  </a>
</article>
