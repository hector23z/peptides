---
import type { CollectionEntry } from 'astro:content';
import eligibleSlugs from '../config/commerceEligible.json';

interface Props {
  product: CollectionEntry<'products'>;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const isEligible = eligibleSlugs.includes(product.id);

const categoryImages: Record<string, string> = {
  recovery: '/images/recovery.png',
  'glp-1': '/images/glp1.png',
  longevity: '/images/longevity.png',
  hgh: '/images/hgh.png',
};

const categoryLabels: Record<string, string> = {
  recovery: 'Recovery',
  'glp-1': 'GLP-1 research',
  longevity: 'Longevity',
  hgh: 'HGH research',
};
---

<article class="product-card">
  <a href={`/${product.data.category}/${product.id}/`} aria-label={`View ${product.data.title}`} class="product-card__link">
    <div class="product-card__media">
      <img
        src={categoryImages[product.data.category] ?? '/images/hero-home.png'}
        alt=""
        width="1254"
        height="1254"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span>{categoryLabels[product.data.category] ?? product.data.category}</span>
    </div>
    <div class="product-card__body">
      <h3>{product.data.title}</h3>
      <p>{product.data.description}</p>
      <dl class="product-card__specs">
        <div>
          <dt>Purity</dt>
          <dd>{product.data.purity ?? 'See batch'}</dd>
        </div>
        <div>
          <dt>Format</dt>
          <dd>{product.data.size ?? 'See listing'}</dd>
        </div>
      </dl>
    </div>
  </a>
  <div class="product-card__footer">
    <span class="product-card__price">{product.data.price ? `$${product.data.price}` : 'Enquire'}</span>
    {isEligible ? (
      <button
        type="button"
        class="product-card__add"
        data-add-to-cart
        data-slug={product.id}
        data-title={product.data.title}
        data-price={product.data.price}
        data-size={product.data.size ?? ''}
      >Add to cart</button>
    ) : (
      <a href={`/${product.data.category}/${product.id}/`} class="product-card__action">View compound</a>
    )}
  </div>
</article>

<script>
  import { addToCart } from '../scripts/cart';
  document.querySelectorAll('[data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', () => {
      addToCart({
        slug: btn.dataset.slug,
        title: btn.dataset.title,
        price: Number(btn.dataset.price),
        size: btn.dataset.size || undefined,
      });
      const original = btn.textContent;
      btn.textContent = 'Added ✓';
      setTimeout(() => { btn.textContent = original; }, 1400);
    });
  });
</script>
