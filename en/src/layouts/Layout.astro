---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Research peptides and laboratory supplies. For research use only.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PeptideLab',
  alternateName: 'PeptideLab Research Peptides',
  url: Astro.site.href,
  description: 'Supplier of high-purity research peptides and laboratory materials. For research use only.',
  email: 'support@peptidelab.example',
  slogan: 'Research use only. Not for human consumption.',
  areaServed: 'Worldwide',
  knowsAbout: [
    'research peptides',
    'GLP-1 receptor agonists',
    'peptide purity testing',
    'certificates of analysis',
    'peptide reconstitution',
  ],
};

const webJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PeptideLab',
  url: Astro.site.href,
  description: 'Research peptides and laboratory supplies. For research use only.',
  publisher: { '@type': 'Organization', name: 'PeptideLab' },
};

const nav = [
  { href: '/research-peptides/', label: 'Compounds' },
  { href: '/recovery/', label: 'Recovery' },
  { href: '/glp-1/', label: 'GLP-1' },
  { href: '/blog/', label: 'Research journal' },
  { href: '/about/', label: 'About' },
];

const footerResearch = [
  { href: '/research-peptides/', label: 'All compounds' },
  { href: '/peptide-purity-guide/', label: 'Purity guide' },
  { href: '/peptide-reconstitution-guide/', label: 'Reconstitution guide' },
  { href: '/how-to-store-peptides/', label: 'Storage guide' },
];

const footerCompany = [
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/shipping/', label: 'Shipping' },
  { href: '/disclaimer/', label: 'Disclaimer' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#081014" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webJsonLd)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="utility-bar">
      <div class="site-shell utility-bar__inner">
        <p><span aria-hidden="true"></span>Research use only</p>
        <p>Not for human or veterinary consumption</p>
      </div>
    </div>

    <header class="site-header">
      <div class="site-shell site-header__inner">
        <a href="/" class="wordmark" aria-label="PeptideLab home">
          <span>PEPTIDE</span><span>LAB</span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
          <span class="nav-toggle__label">Menu</span>
          <span class="nav-toggle__lines" aria-hidden="true"><i></i><i></i></span>
        </button>

        <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>
            ))
          }
          <a href="/contact/" class="nav-contact">Request documentation</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="site-main site-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-shell site-footer__grid">
        <div class="site-footer__brand">
          <a href="/" class="wordmark" aria-label="PeptideLab home">
            <span>PEPTIDE</span><span>LAB</span>
          </a>
          <p>High-purity materials for controlled laboratory research, supplied with clear batch documentation.</p>
          <p class="site-footer__restriction">Research use only. Not for human consumption.</p>
        </div>
        <nav aria-label="Research links">
          <h2>Research</h2>
          {footerResearch.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <nav aria-label="Company links">
          <h2>Company</h2>
          {footerCompany.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="site-footer__contact">
          <h2>Laboratory support</h2>
          <p>Questions about products, orders or certificates of analysis?</p>
          <a href="mailto:support@peptidelab.example">support@peptidelab.example</a>
        </div>
      </div>
      <div class="site-shell site-footer__bottom">
        <p>&copy; {new Date().getFullYear()} PeptideLab</p>
        <nav aria-label="Legal links">
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.querySelector('#primary-nav');
      const closeNavigation = () => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('is-open');
      };

      toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        nav?.classList.toggle('is-open', !expanded);
      });

      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNavigation));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          closeNavigation();
          toggle.focus();
        }
      });
      window.matchMedia('(min-width: 60rem)').addEventListener('change', closeNavigation);
    </script>
  </body>
</html>
