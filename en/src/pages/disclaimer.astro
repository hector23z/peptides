---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Disclaimer — PeptideLab" description="PeptideLab disclaimer: all products are for laboratory research use only, not for human or veterinary consumption.">
  <section class="max-w-3xl">
    <h1 class="font-display text-4xl font-medium tracking-tight text-lab-heading">Disclaimer</h1>
    <div class="mt-8 space-y-6 text-base leading-relaxed text-lab-muted">
      <h2 class="font-display text-xl font-medium text-lab-heading">Research use only</h2>
      <p>
        All products sold by PeptideLab are intended for laboratory research use only. They are not
        intended for human or veterinary consumption, and are not approved by any regulatory authority
        for the diagnosis, treatment, cure or prevention of any disease.
      </p>
      <h2 class="font-display text-xl font-medium text-lab-heading">No medical advice</h2>
      <p>
        The information on this website is provided for general informational purposes only and does not
        constitute medical, legal or professional advice. You should always consult a qualified
        professional for advice specific to your circumstances.
      </p>
      <h2 class="font-display text-xl font-medium text-lab-heading">Age restriction</h2>
      <p>
        This website is intended for adults aged 18 and over. By accessing this site you confirm that
        you are at least 18 years of age.
      </p>
      <h2 class="font-display text-xl font-medium text-lab-heading">No liability</h2>
      <p>
        PeptideLab shall not be held liable for any loss or damage arising from the use of our products
        or the information provided on this website. Use of our products is at the sole discretion and
        responsibility of the purchaser.
      </p>
    </div>
  </section>
</Layout>
