---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({
    params: { category: p.data.category, product: p.id },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const cat = product.data.category;

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.data.title,
  description: `${product.data.description} For laboratory research use only. Not for human or veterinary consumption.`,
  category: cat,
  ...(product.data.price ? { offers: { '@type': 'Offer', price: product.data.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock' } } : {}),
  ...(product.data.purity ? { additionalProperty: { '@type': 'PropertyValue', name: 'Purity', value: product.data.purity } } : {}),
  brand: { '@type': 'Brand', name: 'PeptideLab' },
};
---

<Layout title={`${product.data.title} — PeptideLab`} description={product.data.description}>
  <article class="max-w-3xl">
    <div class="mb-6 flex flex-wrap items-center gap-3 text-sm">
      <a href={`/${cat}/`} class="text-lab-cyan transition-colors hover:text-lab-cyan-pale">{cat}</a>
      <span class="text-lab-faint">/</span>
      <span class="rounded border border-lab-rule px-2 py-0.5 font-mono text-xs text-lab-muted">Purity {product.data.purity}</span>
      {product.data.size && <span class="rounded border border-lab-rule px-2 py-0.5 font-mono text-xs text-lab-muted">{product.data.size}</span>}
      {product.data.price && <span class="rounded border border-lab-cyan-deep px-2 py-0.5 font-mono text-xs text-lab-cyan">${product.data.price}</span>}
    </div>
    <div class="md-content">
      <Content />
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
</Layout>
