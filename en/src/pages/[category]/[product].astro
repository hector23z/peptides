---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';

const productImages = new Set(
  fs.existsSync('public/images/products')
    ? fs.readdirSync('public/images/products').map((f) => f.replace(/\.(png|jpg|webp)$/, ''))
    : []
);

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { category: product.data.category, product: product.id },
    props: {
      product,
      relatedProducts: products
        .filter((candidate) => candidate.data.category === product.data.category && candidate.id !== product.id)
        .sort((a, b) => a.data.order - b.data.order)
        .slice(0, 3),
    },
  }));
}

const { product, relatedProducts } = Astro.props;
const { Content } = await render(product);
const category = product.data.category;

const categoryImages: Record<string, string> = {
  recovery: '/images/recovery.png',
  'glp-1': '/images/glp1.png',
  longevity: '/images/longevity.png',
  hgh: '/images/hgh.png',
};

const productImage = productImages.has(product.id)
  ? `/images/products/${product.id}.png`
  : (categoryImages[category] ?? '/images/hero-home.png');

const categoryLabels: Record<string, string> = {
  recovery: 'Recovery',
  'glp-1': 'GLP-1 research',
  longevity: 'Longevity',
  hgh: 'HGH research',
};

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.data.title,
  description: `${product.data.description} For laboratory research use only. Not for human or veterinary consumption.`,
  category,
  ...(product.data.price ? { offers: { '@type': 'Offer', price: product.data.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock' } } : {}),
  ...(product.data.purity ? { additionalProperty: { '@type': 'PropertyValue', name: 'Purity', value: product.data.purity } } : {}),
  brand: { '@type': 'Brand', name: 'PeptideLab' },
};

const stripMarkdown = (value: string) => value
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
  .replace(/[*_`>#]/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const definition = product.body
  .split(/\r?\n\r?\n/)
  .map(stripMarkdown)
  .find((block) => block && !block.startsWith('|') && !block.startsWith('import '))
  ?? product.data.description;

const faqItems = [
  {
    question: `What is ${product.data.title}?`,
    answer: definition,
  },
  {
    question: `How should researchers verify ${product.data.title}?`,
    answer: `Confirm the exact molecular form on the lot certificate and pair chromatographic purity with an orthogonal identity method such as mass spectrometry or NMR. Use the molecular weight, counterion and content stated for that verified form when calculating molarity.`,
  },
  {
    question: `Is ${product.data.title} intended for human use?`,
    answer: `${product.data.title} is listed for controlled laboratory research only. It is not intended for human or veterinary use.`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout title={`${product.data.title}: Research Data & Handling | PeptideLab`} description={product.data.description}>
  <nav class="breadcrumbs pt-8" aria-label="Breadcrumb">
    <a href="/">Home</a><span>/</span><a href={`/${category}/`}>{categoryLabels[category] ?? category}</a><span>/</span><span>{product.data.title}</span>
  </nav>

  <section class="product-hero mt-6">
    <figure>
      <img src={productImage} alt={`${product.data.title} research vial`} width="1254" height="1254" loading="eager" decoding="async" />
    </figure>
    <div class="product-hero__content">
      <h1>{product.data.title}</h1>
      <p>{product.data.description}</p>
      <dl>
        <div><dt>Purity</dt><dd>{product.data.purity ?? 'See batch documentation'}</dd></div>
        <div><dt>Format</dt><dd>{product.data.size ?? 'See listing'}</dd></div>
        <div><dt>Category</dt><dd>{categoryLabels[category] ?? category}</dd></div>
        <div><dt>Use</dt><dd>Laboratory research only</dd></div>
      </dl>
      <div class="product-hero__purchase">
        <div><span>Listed price</span><strong>{product.data.price ? `$${product.data.price}` : 'Enquire'}</strong></div>
        <a href="/contact/" class="button button--primary">Request batch documentation</a>
      </div>
      <p class="product-hero__notice">Not for human or veterinary consumption.</p>
    </div>
  </section>

  <article class="product-article gap-10">
    <aside class="pb-5">
      <p>Product record</p>
      <a href={`/${category}/`}>Back to {categoryLabels[category] ?? category}</a>
      <a href="/peptide-purity-guide/">Purity guide</a>
      <a href="/how-to-store-peptides/">Storage guide</a>
    </aside>
    <div class="md-content product-content">
      <Content />

      <section class="product-faq mt-20" aria-labelledby="product-faq-title">
        <h2 id="product-faq-title">What Are Common Questions About {product.data.title}?</h2>
        {faqItems.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </section>

      <section class="related-research mt-24" aria-labelledby="related-research-title">
        <h2 id="related-research-title">Which {categoryLabels[category] ?? category} Research Records Are Related?</h2>
        <p>
          Continue with the <a href={`/${category}/`}>{categoryLabels[category] ?? category} category</a>
          {' '}or compare related research records:
        </p>
        <ul>
          {relatedProducts.map((related) => (
            <li><a href={`/${related.data.category}/${related.id}/`}>{related.data.title}</a></li>
          ))}
        </ul>
      </section>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>
