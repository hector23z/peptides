---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — PeptideLab" description="Contact PeptideLab for questions about orders, products or certificates of analysis. For research use only.">
  <section class="max-w-3xl">
    <h1 class="font-display text-4xl font-medium tracking-tight text-lab-heading">Get in touch</h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-lab-muted">
      Questions about an order, a product or a certificate of analysis? Our team is here to help.
      We typically respond within one business day.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <div class="rounded-[12px] border border-lab-rule bg-lab-panel p-6">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-lab-muted">Email</h2>
        <p class="mt-2 font-mono text-lab-text">support@peptidelab.example</p>
      </div>
      <div class="rounded-[12px] border border-lab-rule bg-lab-panel p-6">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-lab-muted">Hours</h2>
        <p class="mt-2 font-mono text-lab-text">Mon&ndash;Fri, 9:00&ndash;18:00 (GMT)</p>
      </div>
    </div>
    <form class="mt-10 space-y-4" method="post" action="/contact/">
      <div>
        <label for="name" class="mb-1 block text-sm text-lab-muted">Name</label>
        <input id="name" name="name" type="text" class="w-full rounded-md border border-lab-rule bg-lab-panel px-4 py-2 text-lab-text outline-none focus:border-lab-cyan" />
      </div>
      <div>
        <label for="email" class="mb-1 block text-sm text-lab-muted">Email</label>
        <input id="email" name="email" type="email" class="w-full rounded-md border border-lab-rule bg-lab-panel px-4 py-2 text-lab-text outline-none focus:border-lab-cyan" />
      </div>
      <div>
        <label for="message" class="mb-1 block text-sm text-lab-muted">Message</label>
        <textarea id="message" name="message" rows="5" class="w-full rounded-md border border-lab-rule bg-lab-panel px-4 py-2 text-lab-text outline-none focus:border-lab-cyan"></textarea>
      </div>
      <button type="submit" class="rounded-md bg-lab-cyan px-6 py-3 text-sm font-semibold text-lab-black transition-colors hover:bg-lab-cyan-pale">
        Send Message
      </button>
    </form>
  </section>
</Layout>
