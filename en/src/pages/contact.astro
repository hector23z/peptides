---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — PeptideLab">
  <section class="max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-widest text-cyan-400">Contact</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-zinc-50">Get in touch</h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-zinc-400">
      Questions about an order, a product or a certificate of analysis? Our team is here to help.
      We typically respond within one business day.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-zinc-800 bg-zinc-900/50 p-6">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-300">Email</h2>
        <p class="mt-2 text-zinc-400">support@peptidelab.example</p>
      </div>
      <div class="rounded-lg border border-zinc-800 bg-zinc-900/50 p-6">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-300">Hours</h2>
        <p class="mt-2 text-zinc-400">Mon&ndash;Fri, 9:00&ndash;18:00 (GMT)</p>
      </div>
    </div>
    <form class="mt-10 space-y-4" method="post" action="/contact/">
      <div>
        <label for="name" class="mb-1 block text-sm text-zinc-300">Name</label>
        <input id="name" name="name" type="text" class="w-full rounded-md border border-zinc-700 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-cyan-500" />
      </div>
      <div>
        <label for="email" class="mb-1 block text-sm text-zinc-300">Email</label>
        <input id="email" name="email" type="email" class="w-full rounded-md border border-zinc-700 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-cyan-500" />
      </div>
      <div>
        <label for="message" class="mb-1 block text-sm text-zinc-300">Message</label>
        <textarea id="message" name="message" rows="5" class="w-full rounded-md border border-zinc-700 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-cyan-500"></textarea>
      </div>
      <button type="submit" class="rounded-md bg-cyan-500 px-6 py-3 text-sm font-semibold text-zinc-950 transition-colors hover:bg-cyan-400">
        Send Message
      </button>
    </form>
  </section>
</Layout>
