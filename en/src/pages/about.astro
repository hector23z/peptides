---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us — PeptideLab" description="PeptideLab is a supplier of high-purity research peptides and laboratory materials for the scientific community. For research use only.">
  <section class="max-w-3xl">
    <h1 class="font-display text-4xl font-medium tracking-tight text-lab-heading">Who we are</h1>
    <div class="mt-8 space-y-6 text-base leading-relaxed text-lab-muted">
      <p>
        PeptideLab is a supplier of high-purity research peptides and laboratory materials for the
        scientific community. We serve researchers, laboratories and academic institutions that require
        reliable, well-documented research compounds.
      </p>
      <p>
        Every product we supply is manufactured under controlled conditions and independently tested
        for purity. Each batch is accompanied by a certificate of analysis so researchers can verify
        the quality of the material they receive.
      </p>
      <p>
        Our mission is to make high-quality research materials accessible while maintaining the highest
        standards of transparency, documentation and customer support.
      </p>
    </div>
    <div class="mt-10 rounded-[12px] border border-lab-rule bg-lab-panel p-6">
      <h2 class="font-display text-lg font-medium text-lab-heading">Research use only</h2>
      <p class="mt-2 text-sm leading-relaxed text-lab-muted">
        PeptideLab supplies products for laboratory research use only. We do not sell products for
        human or veterinary consumption, and we do not provide medical advice.
      </p>
    </div>
  </section>
</Layout>
