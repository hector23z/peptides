---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Research Blog — PeptideLab" description="Guides and research notes on peptides, purity, storage and reconstitution. For research use only.">
  <section class="max-w-3xl">
    <h1 class="font-display text-4xl font-medium tracking-tight text-lab-heading">Research Blog</h1>
    <p class="mt-6 text-base leading-relaxed text-lab-muted">
      Guides and research notes for the scientific community. All content is for research use only.
    </p>
  </section>

  <section class="mt-12">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="group rounded-[12px] border border-lab-rule bg-lab-panel p-6 transition-colors hover:border-lab-cyan/60 hover:bg-lab-panel-raised">
            <h2 class="font-display text-lg font-medium text-lab-heading group-hover:text-lab-cyan">{post.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-lab-muted">{post.data.description}</p>
            <div class="mt-4 flex items-center gap-3 text-xs">
              <time datetime={post.data.pubDate.toISOString()} class="font-mono text-lab-faint">{post.data.pubDate.toISOString().slice(0, 10)}</time>
              <span class="text-lab-faint">&middot;</span>
              <span class="font-mono text-lab-faint">{post.data.author}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
