---
import { getCollection } from 'astro:content';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Layout from '../layouts/Layout.astro';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection('products'))
  .filter((product) => product.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Peptidux — Research Peptides & Laboratory Supplies">
  <section class="home-hero">
    <div class="home-hero__copy">
      <h1>High-purity compounds for controlled research</h1>
      <p>
        Lyophilized research peptides for qualified laboratories, with independent purity testing and
        clear batch documentation.
      </p>
      <div class="button-row">
        <a href="#featured" class="button button--primary">Browse compounds</a>
        <a href="/peptide-purity-guide/" class="button button--secondary">Review quality standards</a>
      </div>
      <dl class="home-hero__facts">
        <div><dt>Purity</dt><dd>&gt;99% on listed compounds</dd></div>
        <div><dt>Verification</dt><dd>Independent HPLC testing</dd></div>
        <div><dt>Documentation</dt><dd>Batch CoA supplied</dd></div>
      </dl>
    </div>
    <figure class="home-hero__media">
      <img
        src="/images/hero-home.png"
        alt="Unlabelled laboratory vials arranged on a dark work surface"
        width="1693"
        height="929"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption><span>Controlled materials</span><span>Representative laboratory imagery</span></figcaption>
    </figure>
  </section>

  <section class="home-section" aria-labelledby="categories-title">
    <SectionHeading
      id="categories-title"
      title="Research categories"
      description="Browse compounds by the laboratory pathways and research areas they are commonly used to investigate."
      href="/research-peptides/"
      linkLabel="View research overview"
    />
    <div class="category-grid">
      {categories.map((category, index) => <CategoryCard category={category} featured={index === 0 || index === 3} />)}
    </div>
  </section>

  <section id="featured" class="home-section" aria-labelledby="featured-title">
    <SectionHeading
      id="featured-title"
      title="Featured compounds"
      description="Current research catalogue selections with key specifications visible before you open the full record."
      href="/research-peptides/"
      linkLabel="Browse all compounds"
    />
    <div class="product-grid">
      {products.map((product, index) => <ProductCard product={product} priority={index < 2} />)}
    </div>
  </section>

  <section class="quality-ledger" aria-labelledby="quality-title">
    <div>
      <h2 id="quality-title">Documentation before decoration</h2>
      <p>Every product record foregrounds the details researchers need to evaluate a material.</p>
    </div>
    <dl>
      <div><dt>Identity</dt><dd>Batch-specific compound record</dd></div>
      <div><dt>Purity</dt><dd>HPLC verification disclosed</dd></div>
      <div><dt>Handling</dt><dd>Storage and reconstitution guidance</dd></div>
      <div><dt>Restriction</dt><dd>Laboratory research use only</dd></div>
    </dl>
  </section>

  <section class="home-section journal-preview" aria-labelledby="journal-title">
    <SectionHeading
      id="journal-title"
      title="Research journal"
      description="Practical notes on identity, storage, handling and compound comparison."
      href="/blog/"
      linkLabel="Read all notes"
    />
    <div class="journal-list">
      {
        posts.map((post) => (
          <article>
            <a href={`/blog/${post.id}/`}>
              <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
              <div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="research-notice">
    <h2>For laboratory research use only</h2>
    <p>
      Products are not intended for human or veterinary consumption and are not approved for diagnostic,
      therapeutic or clinical use. Purchasers must be at least 18 years old.
    </p>
    <a href="/disclaimer/" class="text-link">Read the full disclaimer</a>
  </section>
</Layout>
