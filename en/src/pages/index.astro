---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection('products'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout title="PeptideLab — Research Peptides & Laboratory Supplies">
  <!-- Hero -->
  <section class="py-16 sm:py-24">
    <p class="font-mono text-xs uppercase tracking-widest text-cyan-400">Laboratory research supplies</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-zinc-50 sm:text-5xl">
      High-purity research peptides for scientific study
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
      PeptideLab supplies lyophilized research peptides and laboratory materials to qualified
      researchers. Every batch is tested for purity and supplied with a certificate of analysis.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/peptides/" class="rounded-md bg-cyan-500 px-6 py-3 text-sm font-semibold text-zinc-950 transition-colors hover:bg-cyan-400">
        Browse Peptides
      </a>
      <a href="/about/" class="rounded-md border border-zinc-700 px-6 py-3 text-sm font-semibold text-zinc-200 transition-colors hover:border-cyan-500 hover:text-cyan-300">
        About Us
      </a>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-12">
    <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">Research Categories</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((c) => (
          <a href={`/${c.data.slug}/`} class="group rounded-lg border border-zinc-800 bg-zinc-900/50 p-6 transition-colors hover:border-cyan-500/60">
            <h3 class="text-lg font-semibold text-zinc-100 group-hover:text-cyan-300">{c.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{c.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured products -->
  <section class="py-12">
    <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">Featured Products</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <div class="rounded-lg border border-zinc-800 bg-zinc-900/50 p-6">
            <h3 class="text-lg font-semibold text-zinc-100">{p.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{p.data.description}</p>
            <div class="mt-4 flex items-center justify-between text-sm">
              <span class="font-mono text-xs text-zinc-500">{p.data.purity}</span>
              <span class="font-semibold text-cyan-300">{p.data.price ? `$${p.data.price}` : ''}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="rounded-lg border border-amber-500/30 bg-amber-500/5 p-6">
    <h2 class="text-lg font-semibold text-amber-300">Research Use Only</h2>
    <p class="mt-2 text-sm leading-relaxed text-zinc-400">
      All products on this site are sold for laboratory research use only. They are not intended for
      human or veterinary consumption, and are not approved by any regulatory authority for medical use.
      You must be 18 or older to browse this site.
    </p>
  </section>
</Layout>
