---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection('products'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout title="PeptideLab — Research Peptides & Laboratory Supplies">
  <!-- Hero -->
  <section class="py-16 sm:py-24">
    <h1 class="max-w-3xl font-display text-4xl font-medium leading-tight tracking-tight text-lab-heading sm:text-5xl">
      High-purity research peptides for scientific study
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-lab-muted">
      PeptideLab supplies lyophilized research peptides and laboratory materials to qualified
      researchers. Every batch is tested for purity and supplied with a certificate of analysis.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/peptides/" class="rounded-md bg-lab-cyan px-6 py-3 text-sm font-semibold text-lab-black transition-colors hover:bg-lab-cyan-pale">
        Browse Peptides
      </a>
      <a href="/about/" class="rounded-md border border-lab-cyan px-6 py-3 text-sm font-semibold text-lab-cyan transition-colors hover:bg-lab-cyan-glow">
        About Us
      </a>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-12">
    <h2 class="font-display text-2xl font-medium tracking-tight text-lab-heading">Research Categories</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((c) => (
          <a href={`/${c.data.slug}/`} class="group rounded-[12px] border border-lab-rule bg-lab-panel p-6 transition-colors hover:border-lab-cyan/60 hover:bg-lab-panel-raised">
            <h3 class="font-display text-lg font-medium text-lab-heading group-hover:text-lab-cyan">{c.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-lab-muted">{c.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured products -->
  <section class="py-12">
    <h2 class="font-display text-2xl font-medium tracking-tight text-lab-heading">Featured Products</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <div class="rounded-[12px] border border-lab-rule bg-lab-panel p-6">
            <h3 class="font-display text-lg font-medium text-lab-heading">{p.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-lab-muted">{p.data.description}</p>
            <div class="mt-4 flex items-center justify-between text-sm">
              <span class="font-mono text-xs text-lab-faint">{p.data.purity}</span>
              <span class="font-mono font-medium text-lab-cyan">{p.data.price ? `$${p.data.price}` : ''}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="rounded-[12px] border border-lab-rule bg-lab-cyan-glow p-6">
    <h2 class="font-display text-lg font-medium text-lab-cyan">Research Use Only</h2>
    <p class="mt-2 text-sm leading-relaxed text-lab-muted">
      All products on this site are sold for laboratory research use only. They are not intended for
      human or veterinary consumption, and are not approved by any regulatory authority for medical use.
      You must be 18 or older to browse this site.
    </p>
  </section>
</Layout>
