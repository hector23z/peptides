# PeptideLab e-commerce environment variables
# Copy to .env and fill in real values.

# NOWPayments API key (create at https://app.nowpayments.io)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key

# NOWPayments IPN secret (set in the NOWPayments dashboard -> IPN settings)
NOWPAYMENTS_IPN_SECRET=your_ipn_secret

# Admin password for /admin/ order management
ADMIN_PASSWORD=change_me

# Public site URL used for IPN callback and success/cancel redirects
SITE_URL=https://peptidelab.example

# Optional: override the SQLite data directory (defaults to ./data)
# DATA_DIR=/absolute/path/to/data
