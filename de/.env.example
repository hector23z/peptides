# PeptideLab e-commerce environment variables
# Copy to .env and fill in real values.

# Direct crypto wallet addresses (no third-party processor)
# USDT on TRON (TRC-20) — recommended default
WALLET_USDT_TRC20=your_usdt_trc20_address
# USDC on Ethereum (ERC-20)
WALLET_USDC=your_usdc_erc20_address
# Bitcoin
WALLET_BTC=your_btc_address
# Litecoin
WALLET_LTC=your_ltc_address
# Monero
WALLET_XMR=your_xmr_address

# Admin password for /admin/ order management
ADMIN_PASSWORD=change_me

# Public site URL
SITE_URL=https://peptidelab.example

# Optional: override the SQLite data directory (defaults to ./data)
# DATA_DIR=/absolute/path/to/data
