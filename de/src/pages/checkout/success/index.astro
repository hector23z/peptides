---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Order Placed — PeptideLab" description="Your research compound order has been placed. For laboratory research use only.">
  <section class="site-shell py-16 text-center">
    <h1 class="font-display text-3xl font-medium tracking-tight text-lab-heading">Order Placed</h1>
    <p class="mx-auto mt-4 max-w-xl text-lab-muted">
      Your order has been submitted. Complete the crypto payment at the payment provider to confirm it.
      You will receive a confirmation once the payment is verified.
    </p>
    <a href="/research-peptides/" class="button button--primary mt-6 inline-block">Continue browsing</a>
  </section>
</Layout>
