---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductCard from './ProductCard.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const category = (await getCollection('categories')).find((entry) => entry.data.slug === slug);
const products = (await getCollection('products'))
  .filter((product) => product.data.category === slug)
  .sort((a, b) => a.data.order - b.data.order);

const categoryImages: Record<string, string> = {
  recovery: '/images/recovery.png',
  'glp-1': '/images/glp1.png',
  longevity: '/images/longevity.png',
  hgh: '/images/hgh.png',
};
---

<Layout title={`${category?.data.title ?? slug} — PeptideLab`} description={category?.data.description}>
  <section class="category-hero">
    <div>
      <nav class="breadcrumbs" aria-label="Brotkrümelnavigation"><a href="/">Startseite</a><span>/</span><span>{category?.data.title ?? slug}</span></nav>
      <h1>{category?.data.title ?? slug}</h1>
      <p>{category?.data.description}</p>
      <a href="#category-products" class="button button--primary">Verfügbare Wirkstoffe ansehen</a>
    </div>
    <figure>
      <img src={categoryImages[slug] ?? '/images/hero-home.png'} alt="" width="1254" height="1254" loading="eager" decoding="async" />
    </figure>
  </section>

  <section id="category-products" class="catalog-section">
    <header class="section-heading">
      <div><h2>Verfügbare Wirkstoffe</h2><p>{products.length} Forschungseinträge in dieser Kategorie.</p></div>
    </header>
    {
      products.length > 0 ? (
        <div class="product-grid">
          {products.map((product, index) => <ProductCard product={product} priority={index < 2} />)}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <h3>Derzeit keine Forschungseinträge</h3>
          <p>In dieser Kategorie sind noch keine Wirkstoffeinträge veröffentlicht. Durchsuchen Sie den vollständigen Katalog oder prüfen Sie nach der nächsten Dokumentationsveröffentlichung erneut.</p>
          <a href="/research-peptides/" class="text-link">Alle Wirkstoffe durchsuchen</a>
        </div>
      )
    }
  </section>
</Layout>
